# Configuración opcional de Noted
# Copia este archivo como .env y ajusta los valores que necesites.
# NO hace falta ninguna API key — la app usa el CLI de Claude Code (claude login).

# Modelo de Whisper para transcripción local
# Opciones: tiny, base, small, medium, large
# Recomendado: medium (buen equilibrio velocidad/calidad)
# WHISPER_MODEL=medium

# Idioma de transcripción (omitir para autodetección)
# WHISPER_LANGUAGE=es

# Directorio de salida personalizado (por defecto: carpeta del proyecto)
# OUTPUT_DIR=C:\Users\tu_usuario\Documents\Reuniones

# Fallback de transcripción via OpenAI Whisper API (solo si faster-whisper falla)
# Opcional — si no lo pones, se usa Whisper local
# OPENAI_API_KEY=sk-...
