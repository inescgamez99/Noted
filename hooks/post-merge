#!/bin/sh
# Noted — post-merge hook
#
# Se ejecuta automaticamente tras cada git pull y reinicia la app.
# Toda la logica vive en restart_after_update.ps1: aqui solo se localiza el
# repo y se delega, para no mantener dos copias del mismo procedimiento
# (una en el hook y otra en la skill) que se desincronizan.
#
# git devuelve la ruta en formato C:/Users/..., que PowerShell acepta.
REPO=$(git rev-parse --show-toplevel)

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$REPO/restart_after_update.ps1"

# Nunca fallar el hook: el merge ya ha ocurrido y un exit distinto de 0 solo
# ensucia la salida de git sin poder revertir nada.
exit 0
